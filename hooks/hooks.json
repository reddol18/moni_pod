{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^moni-pod:gpu-(start|stop|extend)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook user-prompt-expansion",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.*runpod.*__(create-pod|delete-pod|update-pod|pod-action|create-cluster|update-cluster|delete-cluster)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*runpod*)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(*RunPod*)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(*moni-pod*)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(*moni_pod*)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(*runpod*)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "PowerShell(*RunPod*)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "PowerShell(*moni-pod*)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "PowerShell(*moni_pod*)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(~/.moni_pod/**)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Edit(~/.moni_pod/**)",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook pre-tool-use",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"${CLAUDE_PLUGIN_ROOT}\" moni-pod hook session-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}